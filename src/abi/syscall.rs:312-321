        nr::KILL => {
            let target_pid = ctx.args[0];
            let signum = ctx.args[1] as u8;
            let ok = handler.kill(target_pid, signum);
            klog_syscall("kill", target_pid);
            if ok {
                return Ok(0);
            }
            return Err(crate::abi::AbiError::Other("ESRCH: no such process"));
        }
