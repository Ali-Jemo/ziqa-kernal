[build]
target = "x86_64-unknown-none"
rustflags = ["-C", "relocation-model=static"]
jobs = 8

[target.'cfg(target_os = "none")']
runner = "bootimage runner"

[unstable]
build-std = ["core", "compiler_builtins", "alloc"]
build-std-features = ["compiler-builtins-mem"]

[profile.dev]
opt-level = 1
panic = "abort"
codegen-units = 16
incremental = true

[profile.dev.package."*"]
opt-level = 0

[profile.release]
opt-level = 3
panic = "abort"

[profile.dev-build]
opt-level = 0
panic = "abort"
codegen-units = 16
incremental = true

[install]
upgrade = "none"
